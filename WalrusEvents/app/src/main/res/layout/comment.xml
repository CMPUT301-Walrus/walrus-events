<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/reply_button"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:text="Reply"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.08"
        app:layout_constraintStart_toEndOf="@+id/dislike_button"
        app:layout_constraintTop_toBottomOf="@+id/comment_body"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/dislike_button"
        android:layout_width="85dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:text="Dislike"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toEndOf="@+id/comment_like_button"
        app:layout_constraintTop_toBottomOf="@+id/comment_body"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/comment_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="Name"
        app:layout_constraintBottom_toBottomOf="@+id/comment_profile_pic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toTopOf="@+id/comment_profile_pic" />

    <ImageView
        android:id="@+id/comment_profile_pic"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/white_square" />

    <TextView
        android:id="@+id/comment_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="Body text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toBottomOf="@+id/comment_profile_pic"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/comment_like_button"
        android:layout_width="85dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:text="Like"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toBottomOf="@+id/comment_body"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>