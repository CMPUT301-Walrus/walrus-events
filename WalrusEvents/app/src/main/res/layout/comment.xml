<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp">

    <Button
        android:id="@+id/reply_button"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:text="Reply"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_body"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/comment_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="Name"
        app:layout_constraintBottom_toBottomOf="@+id/comment_profile_pic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toTopOf="@+id/comment_profile_pic" />

    <ImageView
        android:id="@+id/comment_profile_pic"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/white_square" />

    <TextView
        android:id="@+id/comment_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="Body text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toBottomOf="@+id/comment_profile_pic"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/comment_like_button"
        android:layout_width="85dp"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:text="Like"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toBottomOf="@+id/comment_body"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/likes_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="10"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/comment_like_button"
        app:layout_constraintEnd_toStartOf="@+id/reply_button"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/comment_like_button"
        app:layout_constraintTop_toTopOf="@+id/comment_like_button" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/replies_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="-15dp"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toBottomOf="@+id/comment_view_replies_button" />

    <View
        android:id="@+id/comment_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginBottom="30dp"
        android:background="?android:attr/listDivider"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_profile_pic" />

    <TextView
        android:id="@+id/comment_view_replies_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:text="VIEW REPLIES"
        android:textColor="#3D6EFF"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_like_button" />

    <TextView
        android:id="@+id/comment_hide_replies_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="HIDE REPLIES"
        android:textColor="#3D6EFF"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/replies_view" />

    <ImageView
        android:id="@+id/context_menu_button"
        android:layout_width="25dp"
        android:layout_height="24dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toTopOf="@+id/comment_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/comment_profile_pic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/context_icon_blue" />
</androidx.constraintlayout.widget.ConstraintLayout>