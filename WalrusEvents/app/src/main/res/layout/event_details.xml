<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#96e6f6">

    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-15dp"
            android:layout_marginBottom="40dp"
            android:layout_weight="0"
            android:backgroundTint="#FFD24B"
            android:text="Back"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/event_name"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:text="Event Name"
            android:textAlignment="center"
            android:textAppearance="@style/Base.Theme.WalrusEvents"
            android:textColor="#0F9BE7"
            android:textSize="48sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/event_details_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="70dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/application_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Application Status" />

            <ImageView
                android:id="@+id/event_poster"
                android:layout_width="match_parent"
                android:layout_height="174dp"
                app:srcCompat="@drawable/ic_launcher_foreground" />

            <TextView
                android:id="@+id/Event_Details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="10"
                android:text="Description here" />

            <Button
                android:id="@+id/view_comments_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Comments" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/event_details_scroll_view">

        <Button
            android:id="@+id/see_pool_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FFD24B"
            android:text="See The Pool"
            android:textColor="#000000" />

        <Button
            android:id="@+id/join_event_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FFD24B"
            android:text="+ Join"
            android:textColor="#000000" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>